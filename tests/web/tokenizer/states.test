{"tests": [
{"description": "text", "input": "Hello, Gensokyo", "output": [["Character", "Hello, Gensokyo"]], "errors": []},
{"description": "named reference", "input": "a &amp; b &lt;c&gt;", "output": [["Character", "a & b <c>"]], "errors": []},
{"description": "legacy reference without semicolon", "input": "&copy 2026 &notit; &notin;", "output": [["Character", "\u00a9 2026 \u00acit; \u2209"]], "errors": [{"code": "missing-semicolon-after-character-reference", "line": 1, "col": 5}, {"code": "missing-semicolon-after-character-reference", "line": 1, "col": 15}]},
{"description": "unknown named reference", "input": "&nosuch; &ampx &;", "output": [["Character", "&nosuch; &x &;"]], "errors": [{"code": "unknown-named-character-reference", "line": 1, "col": 8}, {"code": "missing-semicolon-after-character-reference", "line": 1, "col": 13}]},
{"description": "numeric references", "input": "&#65;&#x42;&#X43;&#0;&#128;&#x9F;&#x110000;&#xD800;&#xFFFE;&#13;", "output": [["Character", "ABC\ufffd\u20ac\u0178\ufffd\ufffd\ufffe\r"]], "errors": [{"code": "null-character-reference", "line": 1, "col": 21}, {"code": "control-character-reference", "line": 1, "col": 27}, {"code": "control-character-reference", "line": 1, "col": 33}, {"code": "character-reference-outside-unicode-range", "line": 1, "col": 43}, {"code": "surrogate-character-reference", "line": 1, "col": 51}, {"code": "noncharacter-character-reference", "line": 1, "col": 59}, {"code": "control-character-reference", "line": 1, "col": 64}]},
{"description": "numeric reference without digits or semicolon", "input": "&#; &#x; &#65x &#x41g", "output": [["Character", "&#; &#x; Ax Ag"]], "errors": [{"code": "absence-of-digits-in-numeric-character-reference", "line": 1, "col": 3}, {"code": "absence-of-digits-in-numeric-character-reference", "line": 1, "col": 8}, {"code": "missing-semicolon-after-character-reference", "line": 1, "col": 14}, {"code": "missing-semicolon-after-character-reference", "line": 1, "col": 21}]},
{"description": "NUL in data", "input": "a\u0000b", "output": [["Character", "a\u0000b"]], "errors": [{"code": "unexpected-null-character", "line": 1, "col": 2}]},
{"description": "start and end tags", "input": "<div><P CLASS=Note>x</p></DIV>", "output": [["StartTag", "div", {}], ["StartTag", "p", {"class": "Note"}], ["Character", "x"], ["EndTag", "p"], ["EndTag", "div"]], "errors": []},
{"description": "attributes in every quoting", "input": "<a href=\"x\" title='y' lang=z hidden>", "output": [["StartTag", "a", {"href": "x", "title": "y", "lang": "z", "hidden": ""}]], "errors": []},
{"description": "duplicate attribute keeps the first", "input": "<a id=1 ID=2 id=3>", "output": [["StartTag", "a", {"id": "1"}]], "errors": [{"code": "duplicate-attribute", "line": 1, "col": 11}, {"code": "duplicate-attribute", "line": 1, "col": 16}]},
{"description": "reference in attribute values", "input": "<a href=\"?a=1&amp;b=2&copy=3&lt;\" x=&quot;>", "output": [["StartTag", "a", {"href": "?a=1&b=2&copy=3<", "x": "\""}]], "errors": []},
{"description": "self-closing and solidus", "input": "<br/><img src=x / ><p/ >", "output": [["StartTag", "br", {}, true], ["StartTag", "img", {"src": "x"}], ["StartTag", "p", {}]], "errors": [{"code": "unexpected-solidus-in-tag", "line": 1, "col": 18}, {"code": "unexpected-solidus-in-tag", "line": 1, "col": 23}]},
{"description": "missing whitespace between attributes", "input": "<a b=\"c\"d='e'f>", "output": [["StartTag", "a", {"b": "c", "d": "e", "f": ""}]], "errors": [{"code": "missing-whitespace-between-attributes", "line": 1, "col": 9}, {"code": "missing-whitespace-between-attributes", "line": 1, "col": 14}]},
{"description": "odd characters in names and values", "input": "<a b\"c=d e=f\"g h=`i`>", "output": [["StartTag", "a", {"b\"c": "d", "e": "f\"g", "h": "`i`"}]], "errors": [{"code": "unexpected-character-in-attribute-name", "line": 1, "col": 5}, {"code": "unexpected-character-in-unquoted-attribute-value", "line": 1, "col": 13}, {"code": "unexpected-character-in-unquoted-attribute-value", "line": 1, "col": 18}, {"code": "unexpected-character-in-unquoted-attribute-value", "line": 1, "col": 20}]},
{"description": "equals sign before attribute name", "input": "<a =b>", "output": [["StartTag", "a", {"=b": ""}]], "errors": [{"code": "unexpected-equals-sign-before-attribute-name", "line": 1, "col": 4}]},
{"description": "end tag with attributes", "input": "</div class=x>", "output": [["EndTag", "div"]], "errors": [{"code": "end-tag-with-attributes", "line": 1, "col": 14}]},
{"description": "less-than without a tag", "input": "a < b <3 </ x>", "output": [["Character", "a < b <3 "], ["Comment", " x"]], "errors": [{"code": "invalid-first-character-of-tag-name", "line": 1, "col": 4}, {"code": "invalid-first-character-of-tag-name", "line": 1, "col": 8}, {"code": "invalid-first-character-of-tag-name", "line": 1, "col": 12}]},
{"description": "end tag open edge cases", "input": "</>x</", "output": [["Character", "x</"]], "errors": [{"code": "missing-end-tag-name", "line": 1, "col": 3}, {"code": "eof-before-tag-name", "line": 1, "col": 6}]},
{"description": "comments", "input": "<!-- one --><!----><!--a-b--c--><!--a--!>", "output": [["Comment", " one "], ["Comment", ""], ["Comment", "a-b--c"], ["Comment", "a"]], "errors": [{"code": "incorrectly-closed-comment", "line": 1, "col": 41}]},
{"description": "abrupt comments", "input": "<!--><!--->x", "output": [["Comment", ""], ["Comment", ""], ["Character", "x"]], "errors": [{"code": "abrupt-closing-of-empty-comment", "line": 1, "col": 5}, {"code": "abrupt-closing-of-empty-comment", "line": 1, "col": 11}]},
{"description": "nested comment", "input": "<!-- <!-- x -->", "output": [["Comment", " <!-- x "]], "errors": [{"code": "nested-comment", "line": 1, "col": 10}]},
{"description": "bogus comments", "input": "<!x><!DOCTYP><![CDATA[x]]>", "output": [["Comment", "x"], ["Comment", "DOCTYP"], ["Comment", "[CDATA[x]]"]], "errors": [{"code": "incorrectly-opened-comment", "line": 1, "col": 2}, {"code": "incorrectly-opened-comment", "line": 1, "col": 6}, {"code": "cdata-in-html-content", "line": 1, "col": 22}]},
{"description": "processing instructions", "input": "<?target data?><?t  more data ?><?x>", "output": [["ProcessingInstruction", "target", "data"], ["ProcessingInstruction", "t", "more data "], ["ProcessingInstruction", "x", ""]], "errors": []},
{"description": "xml declaration is a comment", "input": "<?xml version=\"1.0\"?><?xml-stylesheet href=x?>", "output": [["Comment", "?xml version=\"1.0\"?"], ["Comment", "?xml-stylesheet href=x?"]], "errors": [{"code": "disallowed-processing-instruction-target", "line": 1, "col": 6}, {"code": "disallowed-processing-instruction-target", "line": 1, "col": 38}]},
{"description": "bad processing instruction targets", "input": "<?1><?a$b>", "output": [["Comment", "?1"], ["Comment", "?a$b"]], "errors": [{"code": "invalid-first-character-of-processing-instruction-target", "line": 1, "col": 3}, {"code": "invalid-processing-instruction-target", "line": 1, "col": 8}]},
{"description": "doctype html", "input": "<!DOCTYPE html>", "output": [["DOCTYPE", "html", null, null, true]], "errors": []},
{"description": "doctype with identifiers", "input": "<!doctype HTML PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">", "output": [["DOCTYPE", "html", "-//W3C//DTD HTML 4.01//EN", "http://www.w3.org/TR/html4/strict.dtd", true]], "errors": []},
{"description": "doctype system only", "input": "<!DOCTYPE html SYSTEM 'about:legacy-compat'>", "output": [["DOCTYPE", "html", null, "about:legacy-compat", true]], "errors": []},
{"description": "doctype without name", "input": "<!DOCTYPE>", "output": [["DOCTYPE", null, null, null, false]], "errors": [{"code": "missing-doctype-name", "line": 1, "col": 10}]},
{"description": "doctype with junk", "input": "<!DOCTYPE html junk><!DOCTYPE html PUBLIC>", "output": [["DOCTYPE", "html", null, null, false], ["DOCTYPE", "html", null, null, false]], "errors": [{"code": "invalid-character-sequence-after-doctype-name", "line": 1, "col": 15}, {"code": "missing-doctype-public-identifier", "line": 1, "col": 42}]},
{"description": "doctype at end of file", "input": "<!DOCTYPE html PUBLIC \"x", "output": [["DOCTYPE", "html", "x", null, false]], "errors": [{"code": "eof-in-doctype", "line": 1, "col": 24}]},
{"description": "tag at end of file", "input": "<div class=\"x", "output": [], "errors": [{"code": "eof-in-tag", "line": 1, "col": 13}]},
{"description": "RCDATA: references, appropriate end tag", "input": "a &amp; <b> </titlex> </title>", "output": [["Character", "a & <b> </titlex> "], ["EndTag", "title"]], "errors": [], "initialStates": ["RCDATA state"], "lastStartTag": "title"},
{"description": "RCDATA: no appropriate end tag", "input": "x</title>y", "output": [["Character", "x</title>y"]], "errors": [], "initialStates": ["RCDATA state"]},
{"description": "RAWTEXT: no references", "input": "p{} &amp; </style >", "output": [["Character", "p{} &amp; "], ["EndTag", "style"]], "errors": [], "initialStates": ["RAWTEXT state"], "lastStartTag": "style"},
{"description": "script data", "input": "if (a<b) x = '</scr' + 'ipt>'; </script>", "output": [["Character", "if (a<b) x = '</scr' + 'ipt>'; "], ["EndTag", "script"]], "errors": [], "initialStates": ["Script data state"], "lastStartTag": "script"},
{"description": "script data escaped", "input": "<!-- a </script> b", "output": [["Character", "<!-- a "], ["EndTag", "script"], ["Character", " b"]], "errors": [], "initialStates": ["Script data state"], "lastStartTag": "script"},
{"description": "script data double escaped", "input": "<!--<script></script>--></script>", "output": [["Character", "<!--<script></script>-->"], ["EndTag", "script"]], "errors": [], "initialStates": ["Script data state"], "lastStartTag": "script"},
{"description": "script data double escaped dashes", "input": "<!--<script>-x--<-->--></script>", "output": [["Character", "<!--<script>-x--<-->-->"], ["EndTag", "script"]], "errors": [], "initialStates": ["Script data state"], "lastStartTag": "script"},
{"description": "plaintext", "input": "<b>&amp;</plaintext>\u0000", "output": [["Character", "<b>&amp;</plaintext>\ufffd"]], "errors": [{"code": "unexpected-null-character", "line": 1, "col": 21}], "initialStates": ["PLAINTEXT state"]},
{"description": "cdata section", "input": "a]b]]c]]]>d", "output": [["Character", "a]b]]c]d"]], "errors": [], "initialStates": ["CDATA section state"]},
{"description": "cdata at end of file", "input": "x]]", "output": [["Character", "x]]"]], "errors": [{"code": "eof-in-cdata", "line": 1, "col": 3}], "initialStates": ["CDATA section state"]}
]}
