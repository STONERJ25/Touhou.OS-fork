# Writes the applet table of kappabox (what tools/build.py writes as build/gen/kappabox_table.c on the host):
#   grep -h '^APPLET(' *.c | sed 's/^APPLET(\([A-Za-z0-9_]*\)).*/\1/' | sort -u | awk -f gen-applets.awk > table.c
# The names come one per line on standard input, sorted and without repeats.
{ name[NR] = $1 }
END {
    print "/* GENERATED by gen-applets.awk -- the list of kappabox applets. */"
    print "#include <stddef.h>"
    print ""
    for (i = 1; i <= NR; i++) printf "int applet_%s(int argc, char **argv);\n", name[i]
    print ""
    print "struct KbApplet { const char *name; int (*fn)(int, char **); };"
    print "const struct KbApplet kb_applets[] = {"
    for (i = 1; i <= NR; i++) printf "    { \"%s\", applet_%s },\n", name[i], name[i]
    print "    { NULL, NULL }"
    print "};"
    printf "const int kb_napplets = %d;\n", NR
}
