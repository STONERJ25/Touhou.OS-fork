tms 1
title Shrine Steps at Dawn
mood a quiet climb up the stone steps while the mist lifts
author Claude (original)
tempo 84
loop yes

; Four voices and a light beat. C major pentatonic with F and B as passing notes; bars are written one per "|".
channel lead  inst=fm-lead  pan=-0.15 gain=0.90
channel bells inst=fm-pluck pan=0.35  gain=0.75
channel pad   inst=fm-pad   pan=0.00  gain=0.55
channel bass  inst=bass     pan=0.00  gain=0.90
channel drums inst=hat      pan=0.10  gain=0.60

pattern intro
  lead:  r1 | r1 | r1 | r1
  bells: o5 [c8 e8 g8 e8]2 | o4 [a8 >c8 e8 c8 <]2 | o4 [f8 a8 >c8 a8 <]2 | o4 [g8 b8 >d8 b8 <]2
  pad:   o4 e1 | e1 | f1 | d1
  bass:  o2 [c4 g4]2 | [a4 >e4 <]2 | [f4 >c4 <]2 | [g4 >d4 <]2
  drums: r1 | r1 | r1 | r1

